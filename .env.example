# ─────────────────────────────────────────────────────────────────────────────
# .env.example
# Copy this file to .env and fill in your credentials.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── SAP AI Core OAuth2 Credentials ──────────────────────────────────────────
AICORE_CLIENT_ID=your_client_id_here
AICORE_CLIENT_SECRET=your_client_secret_here

# Base API endpoint for SAP AI Core
AICORE_BASE_URL=https://api.ai.prod.eu-central-1.aws.ml.hana.ondemand.com

# OAuth2 token endpoint (your BTP subaccount)
AICORE_AUTH_URL=https://your-subdomain.authentication.eu10.hana.ondemand.com

# Resource group (usually "default" for single-tenant setups)
AICORE_RESOURCE_GROUP=default

# Deployment ID of your LLM model in AI Core
AICORE_DEPLOYMENT_ID=your_deployment_id_here

# ── Model Configuration ──────────────────────────────────────────────────────
# Model alias used in the deployment (e.g., gpt-4o, gpt-35-turbo)
AICORE_MODEL_NAME=gpt-4o

# ── Logging ──────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Fallback (for local testing without SAP AI Core) ─────────────────────────
# Only used if generative-ai-hub-sdk is not installed.
# OPENAI_API_KEY=sk-...
